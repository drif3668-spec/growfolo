APP_NAME=Growfolo API
APP_ENV=development
DATABASE_URL=sqlite:///./growfolo.db
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=re_change_me
# MAIL_FROM is the primary env var; EMAIL_FROM is also accepted as fallback
MAIL_FROM=Growfolo Support <support@growol.store>
UPLOAD_DIR=uploads

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
# Create your OAuth App at: https://github.com/settings/developers
# Authorization callback URL (local): http://localhost:8000/api/v1/auth/github/callback
# Authorization callback URL (prod):  https://www.growol.store/api/v1/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
